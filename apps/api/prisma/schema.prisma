// 한빛물류 이천센터 · 한빛 WMS Lite DB 구조

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // 센터장
  MANAGER // 관리자
  WORKER // 작업자
  SHIPPER // 화주사 담당자
}

enum Zone {
  AMBIENT // 상온
  CHILLED // 냉장
  FROZEN // 냉동
}

enum WorkStatus {
  PLANNED
  DONE
}

enum DamageStatus {
  REPORTED // 보고됨(관리자 미확인)
  CONFIRMED // 관리자 확인
}

enum DocKind {
  GUIDE // 취급 지침서
  CONTRACT // 보관 계약서
}

/// 화주사
model Shipper {
  id         Int            @id @default(autoincrement())
  code       String         @unique
  name       String
  users      User[]
  items      Item[]
  workOrders WorkOrder[]
  lots       StockLot[]
  damages    DamageReport[]
  documents  Document[]
  inquiries  Inquiry[]
  centerAnswers CenterAnswer[]
}

/// 사용자 (역할별)
model User {
  id           Int            @id @default(autoincrement())
  loginId      String         @unique
  passwordHash String
  name         String
  role         Role
  shipperId    Int?
  shipper      Shipper?       @relation(fields: [shipperId], references: [id])
  sessions     Session[]
  docAcks      DocAck[]
  asked        Inquiry[]      @relation("asker")
  handled      Inquiry[]      @relation("handler")
  savedAnswers CenterAnswer[]
  assigned     WorkOrder[]    @relation("assignee")
  reported     DamageReport[] @relation("reporter")
  confirmed    DamageReport[] @relation("confirmer")
}

/// 로그인 세션
model Session {
  token     String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

/// 품목
model Item {
  id         Int            @id @default(autoincrement())
  shipperId  Int
  shipper    Shipper        @relation(fields: [shipperId], references: [id])
  sku        String
  name       String
  zone       Zone
  workOrders WorkOrder[]
  lots       StockLot[]
  damages    DamageReport[]

  @@unique([shipperId, sku])
}

/// 입고 작업지시
model WorkOrder {
  id          Int            @id @default(autoincrement())
  shipperId   Int
  shipper     Shipper        @relation(fields: [shipperId], references: [id])
  itemId      Int
  item        Item           @relation(fields: [itemId], references: [id])
  expectedQty Int
  actualQty   Int?
  location    String
  lotNo       String
  expiryDate  DateTime?
  status      WorkStatus     @default(PLANNED)
  assigneeId  Int?
  assignee    User?          @relation("assignee", fields: [assigneeId], references: [id])
  note        String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?
  lot         StockLot?
  damages     DamageReport[]
}

/// 재고 로트 (입고 완료 시 생성)
model StockLot {
  id          Int        @id @default(autoincrement())
  shipperId   Int
  shipper     Shipper    @relation(fields: [shipperId], references: [id])
  itemId      Int
  item        Item       @relation(fields: [itemId], references: [id])
  workOrderId Int?       @unique
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  location    String
  lotNo       String
  qty         Int
  receivedAt  DateTime   @default(now())
  expiryDate  DateTime?
}

/// 파손 보고
model DamageReport {
  id            Int          @id @default(autoincrement())
  shipperId     Int
  shipper       Shipper      @relation(fields: [shipperId], references: [id])
  itemId        Int?
  item          Item?        @relation(fields: [itemId], references: [id])
  workOrderId   Int?
  workOrder     WorkOrder?   @relation(fields: [workOrderId], references: [id])
  reporterId    Int
  reporter      User         @relation("reporter", fields: [reporterId], references: [id])
  qty           Int          @default(1)
  labelNo       String? // 박스 라벨·송장 번호 (선택)
  description   String
  photo         String? // 이미지 dataURL (축소본)
  status        DamageStatus @default(REPORTED)
  aiGuidance    String?
  aiCitations   Json?
  notifyHours   Int? // 지침서에 적힌 화주사 통보 기한(시간)
  notifyDueAt   DateTime? // 통보 마감 시각 = 보고 시각 + 기한
  notifySource  String? // 기한의 근거 조항
  notifiedAt    DateTime? // 화주사 통보 완료 시각
  notifiedById  Int?
  managerNote   String?
  confirmedById Int?
  confirmedBy   User?        @relation("confirmer", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime     @default(now())
}

/// 문서 (지침서·계약서, 판별 보관)
model Document {
  id            Int        @id @default(autoincrement())
  shipperId     Int
  shipper       Shipper    @relation(fields: [shipperId], references: [id])
  kind          DocKind
  title         String
  version       Int
  isCurrent     Boolean    @default(true)
  changeSummary Json?
  createdAt     DateTime   @default(now())
  chunks        DocChunk[]
  acks          DocAck[]

  @@unique([shipperId, kind, version])
}

/// 문서 조항 (검색 단위)
model DocChunk {
  id         Int      @id @default(autoincrement())
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  order      Int
  section    String
  text       String
  embedding  Float[]
}

/// 개정 읽음 확인 (판당 1회) — 인터뷰 2차(관리자 김)
model DocAck {
  id         Int      @id @default(autoincrement())
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ackedAt    DateTime @default(now())

  @@unique([documentId, userId])
}

enum InquiryStatus {
  NEW // 작업자 요청, 관리자 미처리
  ASKED_SHIPPER // 관리자가 화주사에 문의 중
  SHIPPER_REPLIED // 화주사 답(앱 또는 외부 확인) 도착
  DONE // 작업자에게 전달 완료
}

enum AnswerSource {
  MANAGER // 관리자 판단
  SHIPPER_APP // 화주사가 앱 문의함에서 답
  EXTERNAL // 관리자가 전화·메일로 확인해 기록
}

/// 지침서에 없는 질문의 위임 (작업자 → 관리자 → 화주사 → 관리자 → 작업자) — 인터뷰 3차
model Inquiry {
  id               Int            @id @default(autoincrement())
  shipperId        Int
  shipper          Shipper        @relation(fields: [shipperId], references: [id])
  askerId          Int
  asker            User           @relation("asker", fields: [askerId], references: [id])
  question         String // 작업자 원 질문 (화주사에 노출 금지)
  needsShipper     Boolean        @default(false) // 안전·보관 조건·계약 관련이면 자동 표시 (관리자가 변경 가능)
  status           InquiryStatus  @default(NEW)
  handlerId        Int?
  handler          User?          @relation("handler", fields: [handlerId], references: [id])
  shipperQuestion  String? // 관리자가 정리해 화주사에 보낸 문의
  shipperAskedAt   DateTime?
  shipperAnswer    String?
  shipperAnsweredAt DateTime?
  externalMethod   String? // 전화·메일 등
  source           AnswerSource?
  confirmedDate    DateTime? // 화주사 확인 날짜
  finalAnswer      String? // 작업자에게 전달한 답
  deliveredAt      DateTime?
  savedAnswerId    Int?
  createdAt        DateTime       @default(now())
}

/// 센터 답변: 같은 화주사·같은 상황이면 다음 질문에 지침서 근거와 구분해 보여 줌
model CenterAnswer {
  id               Int      @id @default(autoincrement())
  shipperId        Int
  shipper          Shipper  @relation(fields: [shipperId], references: [id])
  question         String
  answer           String
  shipperConfirmed Boolean  @default(false)
  confirmedDate    DateTime?
  savedById        Int
  savedBy          User     @relation(fields: [savedById], references: [id])
  savedAt          DateTime @default(now())
  needsRecheck     Boolean  @default(false) // 지침 개정 후 재확인 필요
  recheckReason    String?
  embedding        Float[]
}
